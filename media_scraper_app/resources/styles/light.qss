/* ============================================
   Light Theme - AniScraper
   ============================================ */

/* --- Global --- */
QMainWindow, QDialog, QWidget {
    background-color: #ffffff;
    color: #212529;
}

/* --- Menu Bar --- */
QMenuBar {
    background-color: #f8f9fa;
    color: #212529;
    border-bottom: 1px solid #dee2e6;
}
QMenuBar::item:selected {
    background-color: #e9ecef;
}
QMenu {
    background-color: #ffffff;
    color: #212529;
    border: 1px solid #dee2e6;
}
QMenu::item:selected {
    background-color: #4a90e2;
    color: white;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #f8f9fa;
    color: #6c757d;
    border-top: 1px solid #dee2e6;
}

/* --- Tab Widget --- */
QTabWidget::pane {
    border-top: 2px solid #4a90e2;
    background-color: #ffffff;
}
QTabBar::tab {
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
    color: #495057;
    background-color: #f0f0f0;
    border: 1px solid #dee2e6;
    border-bottom: none;
}
QTabBar::tab:selected {
    color: #4a90e2;
    background: #f0f8ff;
}
QTabBar::tab:hover:!selected {
    background-color: #e9ecef;
}

/* --- Splitter --- */
QSplitter::handle {
    background-color: #f0f0f0;
}
QSplitter::handle:vertical {
    border-top: 1px solid #ddd;
    border-bottom: 1px solid #ddd;
}
QSplitter::handle:horizontal {
    border-left: 1px solid #ddd;
    border-right: 1px solid #ddd;
}
QSplitter::handle:hover {
    background-color: #d0d0d0;
}

/* --- PushButton --- */
QPushButton {
    background-color: #f0f0f0;
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 4px 10px;
    color: #333;
    min-height: 24px;
}
QPushButton:hover {
    background-color: #e0e0e0;
    border-color: #999;
}
QPushButton:pressed {
    background-color: #d0d0d0;
}
QPushButton:disabled {
    background-color: #e9ecef;
    color: #adb5bd;
}

/* --- LineEdit --- */
QLineEdit {
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 0 8px;
    background-color: #ffffff;
    color: #212529;
}
QLineEdit:focus {
    border: 1px solid #4a90e2;
}

/* --- ComboBox --- */
QComboBox {
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: #ffffff;
    color: #212529;
}
QComboBox:hover {
    border-color: #999;
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #212529;
    selection-background-color: #4a90e2;
    selection-color: white;
}

/* --- TableWidget --- */
QTableWidget {
    border: 1px solid #ccc;
    background-color: #ffffff;
    color: #212529;
    gridline-color: #e0e0e0;
}
QTableWidget::item {
    padding: 4px;
}
QTableWidget::item:selected {
    background-color: #4a90e2;
    color: white;
}
QHeaderView::section {
    background-color: #f0f0f0;
    color: #333;
    padding: 6px;
    border: 1px solid #ddd;
    font-weight: bold;
}

/* --- ListWidget --- */
QListWidget {
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #ffffff;
    color: #212529;
}
QListWidget::item {
    padding: 12px 8px;
    border-bottom: 1px solid #f5f5f5;
    color: #212529;
}
QListWidget::item:selected {
    background-color: #4a90e2;
    color: white;
    font-weight: bold;
}
QListWidget::item:hover:!selected {
    background-color: #f0f8ff;
}

/* --- ProgressBar --- */
QProgressBar {
    border: 1px solid #ccc;
    border-radius: 4px;
    text-align: center;
    background-color: #f0f0f0;
    color: #333;
}
QProgressBar::chunk {
    background-color: #4a90e2;
    border-radius: 3px;
}

/* --- ScrollBar --- */
QScrollBar:vertical {
    background-color: #f0f0f0;
    width: 12px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background-color: #f0f0f0;
    height: 12px;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- TextEdit --- */
QTextEdit {
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    padding: 6px;
    color: #495057;
    font-size: 13px;
}

/* --- PlainTextEdit (Log Console) --- */
QPlainTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 11px;
    border: 1px solid #333;
    border-radius: 4px;
}

/* --- CheckBox --- */
QCheckBox {
    color: #212529;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

/* --- SpinBox --- */
QSpinBox {
    border: 1px solid #ccc;
    border-radius: 4px;
    padding: 4px;
    background-color: #ffffff;
    color: #212529;
}
QSpinBox:disabled {
    background-color: #e9ecef;
    color: #adb5bd;
}

/* --- Label --- */
QLabel {
    color: #212529;
}
QLabel:disabled {
    color: #adb5bd;
}

/* --- ToolTip --- */
QToolTip {
    background-color: #333;
    color: white;
    border: 1px solid #555;
    padding: 4px;
    border-radius: 4px;
}
